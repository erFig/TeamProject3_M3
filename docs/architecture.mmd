%%{init: {'theme':'base', 'themeVariables': {
  'primaryColor': '#EEF2FF',
  'primaryBorderColor': '#4F46E5',
  'primaryTextColor': '#1E1B4B',
  'lineColor': '#64748B',
  'fontFamily': 'Helvetica, Arial, sans-serif',
  'fontSize': '15px'
}}}%%
flowchart LR
    U["<b>User question</b><br/><i>'How am I doing this month,<br/>and what should I do this week?'</i>"]

    GIN{{"<b>Input guardrail</b><br/>blocks investing / crypto /<br/>tax / retirement questions<br/>and card or account numbers<br/>(no model call)"}}

    subgraph A1[" Agent 1 - Analyst (NRP gpt-oss) "]
        direction TB
        AR["<b>Role:</b> find the facts<br/><b>Reasoning: ReAct</b><br/>Thought -> Action (tool) -><br/>Observation -> repeat"]
        AD{"Fact question<br/>or plan question?"}
        AR --> AD
    end

    HO[["<b>HANDOFF</b> transfer_to_planner<br/><b>Trigger:</b> user asks for a plan,<br/>what to do this week, or how<br/>to reach the goal<br/><b>Payload:</b> FinancialSnapshot<br/>safe-to-spend total + per day,<br/>days to payday, top category + total,<br/>income baseline, goal left + per week,<br/>last-plan result<br/><i>Payload check: numbers must<br/>match tool results</i>"]]

    subgraph A2[" Agent 2 - Planner (NRP gpt-oss) "]
        direction TB
        PR["<b>Role:</b> build this week's plan<br/><b>Reasoning: chain-of-thought</b><br/>1 read snapshot, 2 search guidance,<br/>3 choose save / category / cut %,<br/>4 build plan, 5 save plan, 6 explain"]
    end

    subgraph MCP[" MCP server (mcp_server.py) - all money math in Python "]
        direction TB
        T1["get_spending_by_category<br/>get_safe_to_spend<br/>get_income_variability<br/>get_goal_progress"]
        T2["build_weekly_plan<br/>(daily limit, savings,<br/>category cap)"]
        T3["search_budget_knowledge"]
        T4["save_plan / check_last_plan"]
    end

    DATA[("Fake sample data<br/>profile.json<br/>transactions.csv")]
    KB[("<b>Knowledge layer</b><br/>ChromaDB vector store<br/>5 guides (Penn State<br/>Extension + CFPB)")]
    MEM[("<b>Memory</b><br/>saved weekly plans<br/>memory/plan_history.json")]

    GOUT{{"<b>Output guardrail</b><br/>every $ amount must come<br/>from a tool result<br/>(1 retry, else answer withheld)"}}

    O1["<b>Fact answer</b><br/>e.g. '$39.11/day until payday'"]
    O2["<b>Weekly plan</b><br/>daily limit, savings amount,<br/>category cap, reasons,<br/>one action for today"]

    U ==> GIN
    GIN -- blocked --> X["Polite refusal"]
    GIN == passed ==> AR
    AR <-->|tool calls| T1
    AR <-->|tool calls| T3
    AR <-->|tool calls| T4
    AD -- fact --> GOUT
    AD == plan ==> HO
    HO ==> PR
    PR <-->|tool calls| T3
    PR <-->|tool calls| T2
    PR <-->|tool calls| T4
    T1 -.-> DATA
    T2 -.-> DATA
    T3 -.-> KB
    T4 -.-> MEM
    PR ==> GOUT
    GOUT -- Analyst --> O1
    GOUT -- Planner --> O2

    classDef userNode fill:#F1F5F9,stroke:#475569,stroke-width:1.5px,color:#0F172A
    classDef agentNode fill:#EEF2FF,stroke:#4F46E5,stroke-width:1.5px,color:#1E1B4B
    classDef toolNode fill:#ECFDF5,stroke:#059669,stroke-width:1.5px,color:#064E3B
    classDef dataNode fill:#FFF7ED,stroke:#C2410C,stroke-width:1.5px,color:#7C2D12
    classDef guardNode fill:#FEF2F2,stroke:#DC2626,stroke-width:1.5px,color:#7F1D1D
    classDef handoffNode fill:#FEFCE8,stroke:#CA8A04,stroke-width:2px,color:#713F12
    classDef outNode fill:#FDF4FF,stroke:#A21CAF,stroke-width:1.5px,color:#4A044E

    class U userNode
    class AR,AD,PR agentNode
    class T1,T2,T3,T4 toolNode
    class DATA,KB,MEM dataNode
    class GIN,GOUT,X guardNode
    class HO handoffNode
    class O1,O2 outNode
